# provider: qwen | deepseek
LLM_PROVIDER=qwen

# Qwen / Alibaba Cloud Model Studio
DASHSCOPE_API_KEY=replace_me
# Legacy OpenAI-compatible endpoint. Current Model Studio docs recommend a workspace-specific domain,
# but the legacy domain remains supported. You can override this with your workspace-specific URL.
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# DeepSeek
DEEPSEEK_API_KEY=replace_me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Lab settings
AGENT_MODE=secure
MAX_TOOL_ROUNDS=4
